TI+WXBnRf/SYr0PsTS0WOazciVWIeaFM/YmReRJVJFg=", "last_login": null, "is_superuser": false, "username": "working_now", "is_staff": false, "is_active": true, "date_joined": "2026-09-11T02:20:40.642Z", "first_name": "project", "last_name": "application", "email": "testing123@email.com", "groups": [], "user_permissions": [], "following": [], "followers": [], "reviews": []}}, {"model": "users.user", "pk": 6, "fields": {"password": "pbkdf2_sha256$1200000$JWL460L0QLkAzn0eIrbLV8$GoQLyk6DKuLL6O6BwtflDHXvpRFSV6Mc6SF9OkvJpGI=", "last_login": null, "is_superuser": false, "username": "matchingemail", "is_staff": false, "is_active": true, "date_joined": "2026-09-11T02:39:47.874Z", "first_name": "testing", "last_name": "emailmatch", "email": "different@email.com", "groups": [], "user_permissions": [], "following": [], "followers": [], "reviews": []}}, {"model": "users.user", "pk": 7, "fields": {"password": "pbkdf2_sha256$1200000$gQCKsbi9BVRowWukpIZhEl$vmgp9qrgyKEJc1KtR0m1Kc8zVH+c5qXWDqRdKonfJiQ=", "last_login": null, "is_superuser": false, "username": "ClancyMistrial", "is_staff": false, "is_active": true, "date_joined": "2026-09-11T02:48:44.144Z", "first_name": "Lindsay", "last_name": "Clancy", "email": "postpartum@depression.com", "groups": [], "user_permissions": [], "following": [], "followers": [], "reviews": []}}, {"model": "users.user", "pk": 8, "fields": {"password": "pbkdf2_sha256$1200000$EJKOyOrpnIcpExnQGLjCq3$Ls8hIozHL3HYnYPhsKB6W07R9DtkFQWnCFKDiGcy2bs=", "last_login": null, "is_superuser": false, "username": "dtsweetheart", "is_staff": false, "is_active": true, "date_joined": "2026-09-14T22:29:02.434Z", "first_name": "", "last_name": "", "email": "", "groups": [], "user_permissions": [], "following": [], "followers": [], "reviews": []}}, {"model": "reviews.book", "pk": 1, "fields": {"title": "The Four Agreements", "image": "THE_FOUR_AGREEMENTS.jpg", "description": "The Four Agreements draws on the long tradition of the Toltecs, an ancient, indigenous people of Mexico, to show you that we have been domesticated from childhood, how these internal, guiding rules hurt us and what we can do to break and replace them with a new set of agreements with ourselves.", "created": "2026-09-16T23:53:38.710Z"}}, {"model": "reviews.book", "pk": 2, "fields": {"title": "Anger: Wisdom for Cooling the Flames", "image": "ANGER_WISDOM_FOR_COOLING_THE_FLAMES.jpg", "description": "It was under the bodhi tree in India twenty-five centuries ago that Buddha achieved the insight that three states of mind were the source of all our unhappiness: wrong knowing, obsessive desire, and anger. All are difficult, but in one instant of anger—one of the most powerful emotions—lives can be ruined, and health and spiritual development can be destroyed. With exquisite simplicity, Buddhist monk and Vietnam refugee Thich Nhat Hanh gives tools and advice for transforming relationships, focusing energy, and rejuvenating those parts of ourselves that have been laid waste by anger. His extraordinary wisdom can transform your life and the lives of the people you love, and in the words of Thich Nhat Hanh, can give each reader the power to \"change everything.\"", "created": "2026-09-16T23:57:35.610Z"}}, {"model": "reviews.book", "pk": 3, "fields": {"title": "The Wisdom of Insecurity", "image": "THE_WISDOM_OF_INSECURITY.jpg", "description": "Alan Watts explores man's quest for psychological security, examining our efforts to find spiritual and intellectual certainty in the realms of religion and philosophy. The Wisdom of Insecurity underlines the importance of our search for stability in an age where human life seems particularly vulnerable and uncertain. Watts argues our insecurity is the consequence of trying to be secure and that, ironically, salvation and sanity lie in the recognition that we have no way of saving ourselves.", "created": "2026-09-16T23:58:49.187Z"}}, {"model": "reviews.book", "pk": 4, "fields": {"title": "The 7 Habits of Highly Effective People", "image": "THE_7_HABITS_OF_HIGHLY_EFFECTIVE_PEOPLE.jpg", "description": "Stephen R. Covey presents a holistic, integrated, principle-centered approach for solving personal and professional problems. With penetrating insights and pointed anecdotes, Covey reveals a step-by-step pathway for living with fairness, integrity, service, and human dignity--principles that give us the security to adapt to change and the wisdom and power to take advantage of the opportunities that change creates.", "created": "2026-09-17T00:00:45.824Z"}}, {"model": "reviews.review", "pk": 1, "fields": {"headline": "Inner Thoughts On: The Four Agreements", "body": "The teachings of non-western culture continues to feel like a breathe of fresh air, knowing that there is more beyond this life than accepting the suffering. It is truly a miracle that not more people understand that we are the causes of our sufferings because of how we think and act in the world.", "rating": 5, "book": 1, "user": 3, "created": "2026-09-17T00:05:53.190Z", "updated": "2026-09-17T00:05:53.190Z"}}, {"model": "reviews.review", "pk": 2, "fields": {"headline": "Not Sure I Could Handle One Agreement", "body": "I'm not too sure that I agree that this list of four, almost random agreements will somehow change my life. The world's suffering comes from those who want to incur suffering on others. Everyone else is just falling victim to the backfire of someone else's actions. The truest way for us to stop suffering is to prevent those who would cause us harm, from creating more suffering.", "rating": 2, "book": 1, "user": 7, "created": "2026-09-17T00:08:12.155Z", "updated": "2026-09-17T00:08:12.155Z"}}, {"model": "reviews.review", "pk": 3, "fields": {"headline": "Insecurity has made me wiser!", "body": "I never thought that I could do as much as I've done in my life while having anxiety. I almost accepted that I would be held back from life, forever. My insecurities are just messages for me to listen to in order to redirect my life to better suit me. Its not a sign for me to conform to those around me, whether person or environment. I'm always in control of myself and my own actions.", "rating": 4, "book": 3, "user": 3, "created": "2026-09-17T00:11:19.480Z", "updated": "2026-09-17T00:11:19.480Z"}}, {"model": "admin.logentry", "pk": 1, "fields": {"action_time": "2026-09-16T23:53:38.711Z", "user": 1, "content_type": 2, "object_id": "1", "object_repr": "The Four Agreements", "action_flag": 1, "change_message": "[{\"added\": {}}]"}}, {"model": "admin.logentry", "pk": 2, "fields": {"action_time": "2026-09-16T23:57:35.611Z", "user": 1, "content_type": 2, "object_id": "2", "object_repr": "Anger: Wisdom for Cooling the…", "action_flag": 1, "change_message": "[{\"added\": {}}]"}}, {"model": "admin.logentry", "pk": 3, "fields": {"action_time": "2026-09-16T23:58:49.188Z", "user": 1, "content_type": 2, "object_id": "3", "object_repr": "The Wisdom of Insecurity", "action_flag": 1, "change_message": "[{\"added\": {}}]"}}, {"model": "admin.logentry", "pk": 4, "fields": {"action_time": "2026-09-17T00:00:45.825Z", "user": 1, "content_type": 2, "object_id": "4", "object_repr": "The 7 Habits of Highly Effect…", "action_flag": 1, "change_message": "[{\"added\": {}}]"}}, {"model": "admin.logentry", "pk": 5, "fields": {"action_time": "2026-09-17T00:05:53.191Z", "user": 1, "content_type": 3, "object_id": "1", "object_repr": "Inner Thoughts On: The Four A… (by Pure Grit Studio)", "action_flag": 1, "change_message": "[{\"added\": {}}]"}}, {"model": "admin.logentry", "pk": 6, "fields": {"action_time": "2026-09-17T00:08:12.156Z", "user": 1, "content_type": 3, "object_id": "2", "object_repr": "Not Sure I Could Handle One A… (by Lindsay Clancy)", "action_flag": 1, "change_message": "[{\"added\": {}}]"}}, {"model": "admin.logentry", "pk": 7, "fields": {"action_time": "2026-09-17T00:11:19.481Z", "user": 1, "content_type": 3, "object_id": "3", "object_repr": "Insecurity has made me wiser! (by Pure Grit Studio)", "action_flag": 1, "ch